# Non-secret configuration for the digest function.
#
# These are plain parameters, not credentials — without them the CLI prompts
# for a value on every deploy. The SMTP password is deliberately NOT here: it
# lives in Secret Manager, set once with
#   firebase functions:secrets:set SMTP_PASSWORD
# and bound to the function at deploy time.
#
# Changing the sender later (a Workspace address on iccofutah.org, say) is an
# edit to this file plus a redeploy. No code change.

SMTP_USER=utahindiacc@gmail.com
MAIL_FROM=ICC EventOps <utahindiacc@gmail.com>
